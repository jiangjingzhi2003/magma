<pre class="csharpcode">
 <span class="kwrd">public</span> <span class="kwrd">string</span> getTif(System.IO.Stream file)
        {
            <span class="kwrd">string</span> TextBox1 = <span class="str">""</span>;

            <span class="kwrd">byte</span>[] b = ReadFully(file, file.Length);

            TextBox1 = <span class="str">"Starting tag (should be II - Big Indian): "</span> + (<span class="kwrd">char</span>)b[0] + (<span class="kwrd">char</span>)b[1] + <span class="str">"&lt;br/&gt;"</span>;
            TextBox1 += <span class="str">"Version: "</span> + Global.intToHex(b[2]) + <span class="str">"&lt;br/&gt;"</span>;

            <span class="kwrd">return</span> (TextBox1);
        }</pre>
